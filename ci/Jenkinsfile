// ==============================================================================
// Jenkinsfile — OmniPay Zero-Trust Pipeline CI (Semaine 1 Baseline)
// ==============================================================================
pipeline {
    agent any

    options {
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
    }

    environment {
        APP_NAME = 'omnipay'
        CI_REGISTRY = 'harbor.omnipay.local'
    }

    stages {
        stage('Checkout') {
            steps {
                echo '=== ÉTAPE 1 : RÉCUPÉRATION DU CODE SOURCE ==='
                checkout scm
                script {
                    sh 'git log -1 --pretty=format:"Commit: %h - Auteur: %an - Message: %s"'
                }
            }
        }

        stage('Environment Check') {
            steps {
                echo '=== ÉTAPE 2 : VÉRIFICATION DE L\'ENVIRONNEMENT D\'EXÉCUTION ==='
                sh '''
                    echo "Date UTC: $(date -u)"
                    echo "Hôte: $(hostname)"
                    java -version || echo "[WARN] Java non disponible sur l'agent direct"
                    mvn -version || echo "[WARN] Maven non disponible sur l'agent direct"
                    git --version || echo "[WARN] Git non disponible sur l'agent direct"
                '''
            }
        }

        stage('Secret Scan (Gitleaks)') {
            steps {
                echo '=== ÉTAPE 3 : AUDIT SHIFT-LEFT DES SECRETS (GITLEAKS) ==='
                sh '''
                    if [ -f ci/scripts/audit-secrets.sh ]; then
                        chmod +x ci/scripts/audit-secrets.sh
                        ./ci/scripts/audit-secrets.sh .
                    else
                        echo "[ERREUR] Script d'audit ci/scripts/audit-secrets.sh introuvable !"
                        exit 1
                    fi
                '''
            }
        }

        stage('Maven Build & Tests') {
            steps {
                echo '=== ÉTAPE 4 : COMPILATION & TESTS UNITAIRES DES MICROSERVICES ==='
                script {
                    def services = ['services/auth', 'services/transaction', 'services/notification']
                    def servicesFound = 0

                    for (svc in services) {
                        if (fileExists("${svc}/pom.xml")) {
                            echo "--> Traitement du service : ${svc}"
                            dir(svc) {
                                sh 'mvn -B clean test package -DskipITs'
                            }
                            servicesFound++
                        } else {
                            echo "--> [ATTENTE P2] Aucun pom.xml dans ${svc} pour le moment. Étape ignorée."
                        }
                    }

                    if (fileExists('pom.xml')) {
                        echo "--> Traitement du pom.xml racine..."
                        sh 'mvn -B clean test package'
                    } else if (servicesFound == 0) {
                        echo "[INFO] Aucun pom.xml détecté (en attente de livraison P2). Structure des dossiers validée."
                    }
                }
            }
        }

        stage('Packaging Verification') {
            steps {
                echo '=== ÉTAPE 5 : VÉRIFICATION DES ARTEFACTS ==='
                sh '''
                    echo "Validation de la structure de build terminée avec succès."
                '''
            }
        }
    }

    post {
        success {
            echo '==================================================='
            echo ' OmniPay Zero-Trust CI : BUILD RÉUSSI (SUCCESS)    '
            echo '==================================================='
        }
        failure {
            echo '==================================================='
            echo ' OmniPay Zero-Trust CI : ÉCHEC DÉTECTÉ (FAILURE)   '
            echo '==================================================='
        }
        always {
            echo 'Fin du pipeline OmniPay.'
        }
    }
}
