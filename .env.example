# Copier vers .env (ignore par git) puis adapter :  cp .env.example .env
# Valeurs d'exemple pour l'environnement LOCAL uniquement.
POSTGRES_DB=omnipay_db
POSTGRES_USER=omnipay
POSTGRES_PASSWORD=change_me_locally

# Secret de signature des jetons JWT (HS256, 32 caracteres minimum), partage par auth et transaction.
# Generer une valeur locale :  openssl rand -base64 48   (jamais commitee ; en cluster : Secret Kubernetes)
OMNIPAY_JWT_SECRET=

# Demo jury : autorise le bouton "Simuler Erreur 500" (ROLE_ADMIN). A laisser a false hors demonstration.
OMNIPAY_CHAOS_ENABLED=true
